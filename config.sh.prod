#This is where the import and update script are supposed to be found
project_dir=$(dirname $0)

#If those are in your path just set :
#osm2pgsql=osm2pgsql
#the default is to suppose you find them in ../$tool/ relative to the root of where you put the import and update scipts

#binary paths
osm2pgsql=osm2pgsql
osm2pgsql_replication=osm2pgsql-replication

#database name to choose
base_osm=gis

#directory where temporary diff files will be stored, timeing for import, pid lock files and log files 
#/run/shm/ for a ram disk place is good if you don't care about timeings and logs after reboot
work_dir=/run/shm

#0 doesn't print anything out, 1 prints every commands that we run + output of commands (very usefull for runing the update manually and troubleshoot)
verbosity=0

#record timeings of osm2pgsql-replication and tile generation processing
with_timeings=1

#For osm2pgsql options (we could set the database name in it, but if an external script wants the database name, 
#it would be easier to keep it in a variable) 
#--tag-transform-script ./config/script.lua
common_osm2pgsql_options="-C 6000 --number-processes=5 -p planet_osm -G -s -S $project_dir/osm2pgsql-choosen.style -d $base_osm"
diff_osm2pgsql_options="-a $common_osm2pgsql_options"
import_osm2pgsql_options="-c --flat-nodes /home/big-data/tmp/osm2pgsql-nodes.bin $common_osm2pgsql_options"

#Without flat nodes file, better for small (< 2GB pbf) extracts
#import_osm2pgsql_options="-c --drop $common_osm2pgsql_options"

#Rendering related
#osm2pgsql expire list creation options (if empty no expiration list is built)
#osm2pgsql_expire_option="-e18" : only the deepest/most precise zoom is needed here, expiremeta.pl (dirty method) or tirex-batch recurse/cover the lower zooms themselves
osm2pgsql_expire_option="-e18"
osm2pgsql_expire_tile_list=$work_dir/expire.list
#Max size (in MB) of a single diff applied by osm2pgsql-replication update --once
replication_max_diff_size=50

#List of rendering style to run thru the render_expired commands
#Be sure that this scrpt as the filesystem rights to access tiles 
#separate style name by a space like "style1 style2"
rendering_styles_tiles_to_expire="openhikingmap,opentopomap"

#How to handle tiles impacted by an update :
#  "dirty"  -> just mark impacted metatiles as expired on disk (touch mtime far in the past),
#              so they only get (re)rendered lazily, on-demand, when an actual visitor requests them.
#              Cheap, no wasted rendering of tiles nobody asked for. Uses expiremeta.pl.
#  "render" -> actively queue a render request for every impacted tile right away (via tirex-batch),
#              even if nobody requested it yet. More proactive/eager, but can flood the render queue
#              (background priority though, does not impact live traffic).
expire_method="dirty"

#How far down (lower zoom = wider area, less precise) the dirty marking/recursion goes,
#below this zoom nothing is touched/rendered. Only used by the "dirty" method (expiremeta.pl).
expire_minzoom=13

#You can use this to execute the render_expired with another user like "sudo -u www-data"
render_expired_prefix=""

#Email to contact when the import has ended
end_of_import_email="sylvain@letuffe.org"
